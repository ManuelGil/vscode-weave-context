{
	"name": "vscode-weave-context",
	"displayName": "Weave Context",
	"description": "Author repository-based Markdown knowledge in VS Code with deterministic wikilink navigation, filesystem-backed identity, and documentation continuity.",
	"version": "1.0.1",
	"icon": "icon.png",
	"license": "MIT",
	"publisher": "imgildev",
	"author": {
		"name": "Manuel Gil",
		"email": "support@imgil.dev",
		"url": "https://imgil.dev/"
	},
	"sponsor": {
		"url": "https://github.com/sponsors/ManuelGil"
	},
	"packageManager": "pnpm@10.0.0",
	"engines": {
		"vscode": "^1.102.0",
		"node": ">=22.15.1"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"keywords": [
		"markdown",
		"markdown-knowledge",
		"repository-knowledge",
		"knowledge-repository",
		"engineering-documentation",
		"developer-wiki",
		"software-architecture",
		"implementation-knowledge",
		"architecture-documentation",
		"repository",
		"documentation",
		"repository-documentation",
		"documentation-continuity",
		"developer",
		"wikilinks",
		"navigation",
		"deterministic",
		"filesystem",
		"vscode",
		"context",
		"llm-wiki",
		"okf"
	],
	"homepage": "https://github.com/ManuelGil/vscode-weave-context",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ManuelGil/vscode-weave-context.git"
	},
	"bugs": {
		"url": "https://github.com/ManuelGil/vscode-weave-context/issues"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"files": [
		"out",
		"dist",
		"assets/icon.svg",
		"package*.json",
		"README.md",
		"LICENSE",
		"icon.png",
		"schemas",
		"l10n"
	],
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "Weave Context Configuration",
			"properties": {
				"weaveContext.enable": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%weaveContext.enable.description%"
				},
				"weaveContext.notesRoot": {
					"type": "string",
					"default": ".context",
					"scope": "resource",
					"description": "%weaveContext.notesRoot.description%"
				},
				"weaveContext.treeProjection": {
					"type": "string",
					"enum": [
						"filesystem",
						"category",
						"tags",
						"project",
						"type"
					],
					"default": "filesystem",
					"scope": "resource",
					"description": "%weaveContext.treeProjection.description%"
				}
			}
		},
		"commands": [
			{
				"command": "weaveContext.changeWorkspace",
				"title": "%weaveContext.changeWorkspace.title%",
				"category": "Weave Context"
			},
			{
				"command": "weaveContext.createProjectNote",
				"title": "%weaveContext.createProjectNote.title%",
				"category": "Weave Context"
			},
			{
				"command": "weaveContext.openProjectNote",
				"title": "%weaveContext.openProjectNote.title%",
				"category": "Weave Context"
			},
			{
				"command": "weaveContext.insertNoteLink",
				"title": "%weaveContext.insertNoteLink.title%",
				"category": "Weave Context"
			},
			{
				"command": "weaveContext.switchTreeProjection",
				"title": "%weaveContext.switchTreeProjection.title%",
				"category": "Weave Context",
				"icon": "$(list-tree)"
			},
			{
				"command": "weaveContext.notesExplorer.refreshList",
				"title": "%weaveContext.notesExplorer.refreshList.title%",
				"category": "Weave Context",
				"icon": "$(refresh)"
			},
			{
				"command": "weaveContext.feedback.aboutUs",
				"title": "%weaveContext.feedback.aboutUs%",
				"category": "Weave Context",
				"icon": "$(info)"
			},
			{
				"command": "weaveContext.feedback.reportIssues",
				"title": "%weaveContext.feedback.reportIssues%",
				"category": "Weave Context",
				"icon": "$(bug)"
			},
			{
				"command": "weaveContext.feedback.rateUs",
				"title": "%weaveContext.feedback.rateUs%",
				"category": "Weave Context",
				"icon": "$(star)"
			},
			{
				"command": "weaveContext.feedback.supportUs",
				"title": "%weaveContext.feedback.supportUs%",
				"category": "Weave Context",
				"icon": "$(heart)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "weaveContext.switchTreeProjection",
					"when": "view == weaveContext.notesExplorer",
					"group": "navigation@1"
				},
				{
					"command": "weaveContext.notesExplorer.refreshList",
					"when": "view == weaveContext.notesExplorer",
					"group": "navigation@2"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "weaveContext.notesExplorer",
				"contents": "%viewsWelcome.weaveContext.notesExplorer%"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "ContextExplorer",
					"title": "%weaveContext.treeView.title%",
					"icon": "./assets/icon.svg"
				}
			]
		},
		"views": {
			"ContextExplorer": [
				{
					"id": "weaveContext.notesExplorer",
					"name": "%weaveContext.notesExplorer.title%",
					"visibility": "visible",
					"icon": "$(folder)"
				},
				{
					"id": "weaveContext.contextView",
					"name": "%weaveContext.contextView.title%",
					"type": "webview",
					"visibility": "visible",
					"icon": "$(graph)"
				},
				{
					"id": "weaveContext.feedbackView",
					"name": "%weaveContext.feedbackView%",
					"visibility": "visible",
					"icon": "$(comment-discussion)"
				}
			]
		},
		"jsonValidation": [
			{
				"fileMatch": ".vscode/settings.json",
				"url": "./schemas/config.schema.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm compile",
		"typecheck:extension": "tsc --noEmit -p tsconfig.json",
		"typecheck:webview": "vue-tsc --noEmit -p tsconfig.webview.json",
		"typecheck": "run-p typecheck:*",
		"compile": "pnpm typecheck:extension && rimraf out && esbuild src/extension.ts --bundle --platform=node --target=node22 --format=cjs --external:vscode --outfile=out/extension.js",
		"watch": "tsc -watch -p ./",
		"pretest": "pnpm typecheck && pnpm compile && pnpm lint",
		"dev": "vite",
		"build": "pnpm typecheck:webview && vite build --mode production && vite build --mode production --config vite.config.worker.ts",
		"preview": "vite preview",
		"build-only": "vite build",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write --unsafe .",
		"test": "vscode-test",
		"test:unit": "mocha -r ts-node/register src/test/**/*.test.ts",
		"l10n:check": "node scripts/check-l10n.js",
		"nls:check": "node scripts/check-nls.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@tsconfig/node24": "^24.0.4",
		"@types/dagre": "^0.7.54",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.1",
		"@types/vscode": "^1.102.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^2.5.2",
		"@vue/tsconfig": "^0.9.1",
		"esbuild": "^0.28.1",
		"glob": "^11.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"minimatch": "^10.2.6",
		"mocha": "^11.7.6",
		"npm-run-all2": "^8.0.4",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-tsc": "^3.3.8"
	},
	"dependencies": {
		"@supercharge/promise-pool": "^3.3.0",
		"dagre": "^0.8.5",
		"fast-glob": "^3.3.3",
		"graphology": "^0.26.0",
		"ignore": "^7.0.6",
		"sigma": "^3.0.3",
		"vscode-marketplace-client": "^1.2.5",
		"vue": "^3.5.40"
	},
	"pnpm": {
		"overrides": {
			"axios@>=1.7.0 <1.18.0": ">=1.18.0",
			"brace-expansion@<=5.0.7": ">=5.0.8",
			"diff@>=6.0.0 <8.0.3": ">=8.0.3",
			"fast-uri@>=3.0.0 <3.1.3": ">=3.1.3",
			"js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
			"linkify-it@<=5.0.1": ">=5.0.2",
			"serialize-javascript@>=5.0.0 <7.0.5": ">=7.0.5",
			"shell-quote@<=1.8.4": ">=1.9.0"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
